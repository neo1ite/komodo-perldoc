<?xml version="1.0"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:em="http://www.mozilla.org/2004/em-rdf#">
    <Description about="urn:mozilla:install-manifest">
        <em:unpack>true</em:unpack>
        <em:id>komodo-perldoc@neolite.ru</em:id>
        <em:name>Komodo Perldoc</em:name>
        <em:version>0.1.3</em:version>
        <em:description>Local perldoc fallback for Komodo IDE Documentation.</em:description>
        <em:creator>neo1ite</em:creator>
        <em:homepageURL>https://github.com/neo1ite/komodo-perldoc</em:homepageURL>
        <em:type>2</em:type>
        <em:bootstrap>true</em:bootstrap>

        <em:targetApplication>
            <Description>
                <em:id>{36E66FA0-F259-11D9-850E-000D935D3368}</em:id>
                <em:minVersion>9.3</em:minVersion>
                <em:maxVersion>9.*</em:maxVersion>
            </Description>
        </em:targetApplication>
    </Description>
</RDF>
